# Signs the admin session cookie. Falls back to APP_KEY so the existing Vercel env keeps working.
SECRET_KEY=
APP_URL=http://localhost:5173
APP_DEBUG=true

# Either DATABASE_URL, or the Laravel-style DB_* variables (Neon Postgres).
# Leave both empty to use a local SQLite file (run `python -m app.cli init-db && python -m app.cli seed`).
DATABASE_URL=
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require

# MAIL_MAILER=smtp sends real email; anything else only logs it.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@vanillaroyal.id
MAIL_FROM_NAME="Vanilla Royal"
